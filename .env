# Default configuration (committed).
# Override any of these locally in .env.local (gitignored) or via real
# environment variables in deployment.

# Server port
PORT=3000

# Backend API hostname
API=https://reqres.in

# Backend API key (reqres.in requires one). Set a real value in .env.local:
# API_KEY=<your-key>

# Serve static files (public/ and built assets) with the app server
WITH_STATIC=true

# Store sessions in Redis (requires a running Redis instance)
WITH_REDIS=false

# Fastify logger (pino-pretty)
LOGGER=true

# Session cookie secret (required). Set a real value in .env.local:
# SESSION_SECRET=<random-string>

# Redis database index for sessions
# SESSION_REDIS_DB=1

# Error monitoring with Sentry
# SENTRY_DSN=

# Deployment environment marker (production | staging)
# ENVIRONMENT=production

# HTTPS/HTTP2 certificate (absolute paths)
# CERT_KEY=/absolute/path/to/key.pem
# CERT_CERT=/absolute/path/to/cert.pem
