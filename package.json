{
  "name": "iso",
  "version": "2.0.0",
  "description": "Iso is a framework for creating isomorphic single-page applications with SSR, running on Bun.",
  "main": "server/index.mjs",
  "repository": "git@github.com:ogarich89/iso.git",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun server/index.mjs",
    "build": "vite build --ssrManifest --outDir dist/client && vite build --ssr src/app/server.tsx --outDir dist/server",
    "start": "NODE_ENV=production bun server/index.mjs",
    "serve": "bun run build && bun run start",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "stylelint": "stylelint \"**/*.{css,scss,sass}\" --customSyntax=postcss-scss",
    "deadcode": "knip"
  },
  "browserslist": [
    "last 2 years",
    "> 5%",
    "not IE 11"
  ],
  "pre-commit": [
    "test",
    "typecheck",
    "lint",
    "stylelint",
    "deadcode"
  ],
  "author": "ogarich89 <ogarich89@icloud.com>",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/session": "^11.1.3",
    "@fastify/static": "^10.1.4",
    "@sentry/bun": "^10.75.0",
    "@tanstack/react-query": "^5.103.1",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "connect-redis": "^10.0.0",
    "fastify": "^5.12.5",
    "i18next": "^26.4.2",
    "i18next-http-backend": "^4.0.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.47.0",
    "pino-pretty": "^13.1.3",
    "qs": "^6.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router": "^8.4.0",
    "reset-css": "^5.0.2",
    "serialize-javascript": "^7.1.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fastify/middie": "^9.3.4",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/serialize-javascript": "^5.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.0.5",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "postcss": "^8.5.28",
    "postcss-combine-media-query": "^2.1.0",
    "postcss-import": "^17.0.0",
    "postcss-scss": "^4.0.9",
    "pre-commit": "^2.0.0",
    "sass-embedded": "^1.104.1",
    "stylelint": "^17.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.1"
  }
}
